flowchart TD
  subgraph U["User Channels"]
    U1["LINE (ตอนนี้ target หลัก)"]
    U2["ช่องทางอื่นผ่าน OpenClaw (อนาคต)"]
  end

  subgraph O["OpenClaw Core (มีอยู่แล้ว)"]
